# Copy to apps/web/.env (the Next.js app and Prisma read it from there).

# PostgreSQL from docker-compose (port 5433 on the host)
DATABASE_URL="postgresql://optitaxi:optitaxi@localhost:5433/optitaxi?schema=public"

# Optimizer service (docker-compose or `uvicorn app.main:app --port 8100`)
OPTIMIZER_URL="http://localhost:8100"
# Shared secret with the optimizer: sent as "Authorization: Bearer …". When the
# optimizer has one (its own OPTIMIZER_TOKEN), it refuses calls without the same
# value (401). Leave empty in development; set it on both sides in production
# (openssl rand -base64 32). The server warns at startup in production without it.
OPTIMIZER_TOKEN=""

# Session signing secret: whoever knows it can sign in as anyone. Generate one with:
#   openssl rand -base64 48
# (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# At least 32 characters in development, 43 in production. The placeholder
# below only works in development: with NODE_ENV=production (`next start`) the
# server stops at startup with a secret containing "change-me" or shorter than
# 43 characters. Never reuse the development secret.
SESSION_SECRET="change-me-dev-only-secret-at-least-32-chars"

# Sign-in throttling keys on the client IP address only behind reverse proxies
# that append it to X-Forwarded-For (nginx: proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for;) and with the Next.js port reachable through them
# alone (next start -H 127.0.0.1). Number of such proxies: 1 behind nginx on the
# HDS host. 0 (default) trusts no header: all clients share one address bucket
# (120 attempts per 5 min for everyone together), and with NODE_ENV=production
# the server warns at startup. Production mode (`next start`) also needs HTTPS
# on any origin other than localhost: the session cookie is Secure.
TRUSTED_PROXY_HOPS="0"

# MapLibre style (no API key needed). Any MapLibre style JSON URL works.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Address geocoding (French national address base via the IGN Géoplateforme).
# Leave empty to disable geocoding and type coordinates by hand.
GEOCODER_URL="https://data.geopf.fr/geocodage/search"
