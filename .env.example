# Copy to apps/web/.env (the Next.js app and Prisma read it from there).

# PostgreSQL from docker-compose (port 5433 on the host)
DATABASE_URL="postgresql://optitaxi:optitaxi@localhost:5433/optitaxi?schema=public"

# Optimizer service (docker-compose or `uvicorn app.main:app --port 8100`)
OPTIMIZER_URL="http://localhost:8100"

# Session signing secret: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-dev-only-secret-at-least-32-chars"

# MapLibre style (no API key needed). Any MapLibre style JSON URL works.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Address geocoding (French national address base via the IGN Géoplateforme).
# Leave empty to disable geocoding and type coordinates by hand.
GEOCODER_URL="https://data.geopf.fr/geocodage/search"
