// Data model of the J+1 route planner for Taxi & Ambulance V.
// Units: times of the planned day are Int minutes since local midnight
// (Europe/Paris), real instants are DateTime (UTC), service dates are @db.Date,
// distances km, money euros, rates fractions. Weekdays are ISO (1 = Monday).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mobility {
  SEATED
  WHEELCHAIR
  LYING
}

/// Mode prescrit sur la PMT : TAP (taxi conventionné ou VSL) ou ambulance (allongé).
enum PrescribedMode {
  TAP
  AMBULANCE
}

/// Partage autorisé par la prescription.
enum SharingScope {
  NONE
  OUTBOUND
  RETURN
  BOTH
}

enum FacilityType {
  HOSPITAL
  DIALYSIS
  RADIOTHERAPY
  CHEMOTHERAPY
  CLINIC
  OTHER
}

/// Legs generated by a recurrence.
enum RecurrenceLegs {
  OUTBOUND
  RETURN
  BOTH
}

enum TripDirection {
  OUTBOUND
  RETURN
}

enum TripStatus {
  PLANNED
  ASSIGNED
  PICKED_UP
  DROPPED_OFF
  CANCELLED
  NO_SHOW
}

/// Motif d'annulation d'une course.
enum CancellationReason {
  /// Demande du patient.
  PATIENT
  /// Séance annulée ou déplacée par l'établissement.
  FACILITY
  HOSPITALIZATION
  /// Le patient se rend aux soins par ses propres moyens.
  OWN_MEANS
  DECEASED
  /// Course confiée à un confrère (sous-traitance).
  PARTNER
  /// Annulée par la synchronisation du référentiel (patient, prescription ou récurrence modifiés).
  REFERENTIAL_SYNC
  /// Décision de la régulation.
  REGULATION
  OTHER
}

/// Qui a annulé : une personne (« Annuler la course ») ou l'application (synchronisation du référentiel).
/// Seule une annulation SYSTEM est relancée d'office quand sa cause disparaît.
enum CancellationOrigin {
  USER
  SYSTEM
}

/// Traçabilité du transport partagé (décret 2025-202).
enum SharingStatus {
  NOT_ELIGIBLE
  NOT_PROPOSED
  PROPOSED
  ACCEPTED
  REFUSED
}

enum Payer {
  CPAM
  PRIVATE
}

enum VehicleType {
  TAXI
  VSL
  AMBULANCE
}

enum Qualification {
  TAXI_CARD
  AUXILIARY
  DEA
}

/// Motif d'indisponibilité datée d'une personne. Une garde (permanence d'urgence) retire la personne
/// des transports planifiés de la journée, comme un congé.
enum AbsenceKind {
  LEAVE
  SICK
  TRAINING
  ON_CALL
  OTHER
}

/// Motif d'indisponibilité datée d'un véhicule. Garde : le véhicule est réservé à la permanence d'urgence.
enum VehicleUnavailabilityKind {
  MAINTENANCE
  REPAIR
  INSPECTION
  ON_CALL
  OTHER
}

/// Échéance d'entretien ou réglementaire d'un véhicule.
enum MaintenanceKind {
  INSPECTION
  SERVICE
  TIRES
  INSURANCE
  OTHER
}

/// Énergie d'un véhicule : unité de consommation (litres, kWh), et plus tard coût et autonomie (lot 5).
enum EnergyType {
  DIESEL
  PETROL
  HYBRID
  ELECTRIC
  OTHER
}

/// Niveau de vérification d'une valeur réglementaire (grille tarifaire, zone tarifaire).
enum TariffVerification {
  /// Lue sur le texte officiel (Légifrance, JO, ameli).
  OFFICIAL
  /// Lue sur une source secondaire (fédération, CPAM locale, éditeur).
  SECONDARY
  UNVERIFIED
}

/// Zone tarifaire : forfait « Grande ville » (taxi) ou forfait agglomération (ambulance).
enum TariffAreaKind {
  BIG_CITY
  AGGLOMERATION
}

/// Quand un trajet relève d'une zone tarifaire.
enum TariffAreaRule {
  /// Prise en charge ou dépose dans l'une des communes (Grande ville).
  ANY_END
  /// Prise en charge et dépose dans les communes de la zone (agglomération de Marseille).
  BOTH_INSIDE
  /// Entre une commune de la zone et la commune centre, dans les deux sens (agglomération d'Avignon).
  TO_HUB
}

/// Majoration « retour à vide » du taxi pour un transport lié à une hospitalisation (convention 2025) :
/// NONE = jamais ; DEPOT = l'aller dont la dépose termine la tournée, le retour dont la prise en charge
/// la commence (le véhicule rentre à vide à sa station, ou en vient).
enum EmptyLegRule {
  NONE
  DEPOT
}

/// Retour à vide et majoration nuit / week-end sur le tarif km : multipliés ou additionnés.
enum SurchargeOrder {
  MULTIPLICATIVE
  ADDITIVE
}

/// Nombre de patients d'un transport partagé pour son abattement : 1 + co-passagers distincts, ou le plus
/// grand nombre de patients à bord en même temps.
enum SharedPatientCount {
  DISTINCT
  MAX_ON_BOARD
}

enum RouteStatus {
  PROPOSED
  VALIDATED
}

enum StopKind {
  PICKUP
  DROPOFF
}

enum OptimizationRunStatus {
  RUNNING
  SUCCESS
  FAILED
  /// Calcul terminé mais moins bon que le planning en place (ou invalide) : il attend que le régulateur le confirme.
  AWAITING_CONFIRMATION
}

enum UserRole {
  REGULATOR
  DRIVER
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String?
  address     String
  postalCode  String
  city        String
  lat         Float
  lng         Float
  mobility    Mobility @default(SEATED)
  accessNotes String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prescriptions Prescription[]
  recurrences   Recurrence[]
  trips         Trip[]

  @@index([lastName, firstName])
}

model Facility {
  id         String       @id @default(cuid())
  name       String
  type       FacilityType
  address    String
  postalCode String
  city       String
  lat        Float
  lng        Float
  /// Accueil, prévenu des arrivées en transport partagé.
  phone      String?
  notes      String?
  /// Minutes ajoutées au temps d'arrêt à l'établissement (dépose d'un aller, prise en charge d'un retour) : accueil, étages.
  extraServiceMin Int     @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  recurrences Recurrence[]
  trips       Trip[]
}

model Prescription {
  id         String         @id @default(cuid())
  patientId  String
  mode       PrescribedMode
  sharing    SharingScope   @default(BOTH)
  validFrom  DateTime       @db.Date
  validTo    DateTime       @db.Date
  isSeries   Boolean        @default(false)
  prescriber String?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recurrences Recurrence[]
  trips       Trip[]

  @@index([patientId])
}

model Recurrence {
  id                String         @id @default(cuid())
  patientId         String
  facilityId        String
  prescriptionId    String
  /// Libellé libre, ex. « Dialyse ».
  label             String?
  weekdays          Int[]
  appointmentMinute Int
  sessionMinutes    Int
  legs              RecurrenceLegs @default(BOTH)
  startDate         DateTime       @db.Date
  endDate           DateTime?      @db.Date
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility     Facility     @relation(fields: [facilityId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  trips        Trip[]

  @@index([patientId])
  // Facility pages and the sync of a moved facility read its recurrences.
  @@index([facilityId])
}

model Trip {
  id                  String        @id @default(cuid())
  serviceDate         DateTime      @db.Date
  direction           TripDirection
  patientId           String
  prescriptionId      String?
  recurrenceId        String?
  facilityId          String?
  payer               Payer         @default(CPAM)
  allowedVehicleTypes VehicleType[]

  // Address snapshot taken when the trip is created.
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float

  /// OUTBOUND : heure du rendez-vous (arrivée au plus tard).
  appointmentMinute Int?
  /// RETURN : heure de fin de séance (prise en charge au plus tôt).
  readyMinute       Int?

  status TripStatus @default(PLANNED)

  /// Prescription compatible avec le partage pour ce trajet (aller/retour).
  sharingAllowed       Boolean       @default(false)
  sharingStatus        SharingStatus @default(NOT_PROPOSED)
  sharingProposedAt    DateTime?
  sharingRespondedAt   DateTime?
  /// Compte qui a enregistré la réponse du patient (acceptation ou refus).
  sharingRespondedById String?
  sharingNote          String?

  /// Verrou manuel : la course reste sur ce véhicule à la réoptimisation.
  lockedVehicleId String?
  routeId         String?

  // Last planning result for this trip.
  plannedPickupMinute  Int?
  plannedDropoffMinute Int?
  shared               Boolean @default(false)
  directKm             Float?
  detourKm             Float?
  estimatedRevenue     Float?

  /// Annulation : motif, origine, précision libre (non médicale), instant et compte dont l'action a
  /// annulé la course. Vidés quand la course est rétablie.
  cancellationReason CancellationReason?
  cancellationOrigin CancellationOrigin?
  cancellationNote   String?
  cancelledAt        DateTime?
  cancelledById      String?
  /// Annulée par une personne moins de AppSettings.lateCancellationHours avant la prise en charge prévue.
  lateCancellation   Boolean             @default(false)

  /// Péages facturés sur la facture de ce patient (€), hors majorations et abattements.
  tollAmount              Float?
  /// Recours exceptionnel à une ambulance pour ce transport assis (protocole du 24 septembre 2025),
  /// proposé par un régulateur, jamais automatique : facturé au tarif VSL tant que la course reste
  /// figée sur une ambulance. Instant et compte de la proposition.
  exceptionalAmbulanceAt   DateTime?
  exceptionalAmbulanceById String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription       Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  recurrence         Recurrence?   @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  facility           Facility?     @relation(fields: [facilityId], references: [id])
  lockedVehicle      Vehicle?      @relation("TripLockedVehicle", fields: [lockedVehicleId], references: [id], onDelete: SetNull)
  route              Route?        @relation(fields: [routeId], references: [id], onDelete: SetNull)
  sharingRespondedBy User?         @relation("TripSharingRespondedBy", fields: [sharingRespondedById], references: [id], onDelete: SetNull)
  cancelledBy        User?         @relation("TripCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  exceptionalAmbulanceBy User?     @relation("TripExceptionalAmbulanceBy", fields: [exceptionalAmbulanceById], references: [id], onDelete: SetNull)
  stops              RouteStop[]

  @@unique([recurrenceId, serviceDate, direction])
  @@index([serviceDate])
  @@index([patientId, serviceDate])
  // Sync of a changed prescription or a moved facility: its trips to come (patients/_lib/trip-sync-db.ts).
  @@index([prescriptionId])
  @@index([facilityId, serviceDate])
}

/// Dépôt : lieu de rattachement des véhicules (départ et retour des tournées) et du personnel.
model Depot {
  id        String   @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  drivers  Driver[]
}

model Vehicle {
  id                String      @id @default(cuid())
  label             String
  registration      String      @unique
  type              VehicleType
  /// Patients simultanés (ambulance : 1).
  capacity          Int         @default(2)
  /// Dépôt de départ et de retour des tournées.
  depotId           String
  /// Département de rattachement. Taxi : département de l'ADS, qui choisit sa grille tarifaire ; VSL et
  /// ambulance : la grille dépend de la certification et du siège de l'entreprise (AppSettings).
  department        String
  /// Équipé pour transporter un patient dans son fauteuil roulant (supplément TPMR de la grille).
  tpmrEquipped      Boolean     @default(false)
  /// Énergie (null : non renseignée).
  energy            EnergyType?
  costPerKm         Float
  defaultDriverId   String?
  defaultCrewMateId String?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  depot           Depot   @relation(fields: [depotId], references: [id])
  defaultDriver   Driver? @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)
  defaultCrewMate Driver? @relation("VehicleDefaultCrewMate", fields: [defaultCrewMateId], references: [id], onDelete: SetNull)
  routes          Route[]
  dayCrews        DayCrew[]
  unavailabilities VehicleUnavailability[]
  maintenance     MaintenanceDeadline[]
  fuelLogs        FuelLog[]
  lockedTrips     Trip[]  @relation("TripLockedVehicle")

  @@index([depotId])
}

model Driver {
  id                     String          @id @default(cuid())
  firstName              String
  lastName               String
  phone                  String?
  qualifications         Qualification[]
  workDays               Int[]
  shiftStartMinute       Int
  shiftEndMinute         Int
  breakWindowStartMinute Int?
  breakWindowEndMinute   Int?
  breakMinutes           Int             @default(0)
  /// Coût horaire chargé (€/h).
  hourlyCost             Float
  /// Dépôt de rattachement (facultatif) : où la personne prend son service.
  depotId                String?
  active                 Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  depot               Depot?    @relation(fields: [depotId], references: [id], onDelete: SetNull)
  absences            StaffAbsence[]
  incompatibleWith    CrewIncompatibility[] @relation("IncompatibilityA")
  incompatibleWithB   CrewIncompatibility[] @relation("IncompatibilityB")
  dayCrewsAsDriver    DayCrew[]             @relation("DayCrewDriver")
  dayCrewsAsCrewMate  DayCrew[]             @relation("DayCrewCrewMate")
  user                User?
  defaultForVehicles  Vehicle[] @relation("VehicleDefaultDriver")
  crewMateForVehicles Vehicle[] @relation("VehicleDefaultCrewMate")
  routes              Route[]   @relation("RouteDriver")
  crewRoutes          Route[]   @relation("RouteCrewMate")
}

/// Indisponibilité d'un véhicule du startDate au endDate inclus (entretien, réparation, garde…) : il n'est pas planifié.
model VehicleUnavailability {
  id        String                    @id @default(cuid())
  vehicleId String
  kind      VehicleUnavailabilityKind
  startDate DateTime                  @db.Date
  endDate   DateTime                  @db.Date
  note      String?
  createdAt DateTime                  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate])
  @@index([startDate, endDate])
}

/// Échéance d'un véhicule : à une date, à un kilométrage, ou au premier des deux. Faite quand doneDate est renseignée.
model MaintenanceDeadline {
  id        String          @id @default(cuid())
  vehicleId String
  kind      MaintenanceKind
  /// Précision libre, ex. « Vidange + filtres ».
  label     String?
  dueDate   DateTime?       @db.Date
  dueKm     Int?
  note      String?
  doneDate  DateTime?       @db.Date
  doneKm    Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

/// Plein de carburant ou recharge : kilométrage au compteur, quantité (L ou kWh selon l'énergie), montant (€).
model FuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  date       DateTime @db.Date
  odometerKm Int
  quantity   Float
  cost       Float
  /// Plein complet (ou charge complète) : seuls les pleins complets bornent un calcul de consommation.
  fullTank   Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

/// Indisponibilité d'une personne du startDate au endDate inclus (congé, maladie, formation, garde…).
model StaffAbsence {
  id        String      @id @default(cuid())
  driverId  String
  kind      AbsenceKind
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  note      String?
  createdAt DateTime    @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startDate])
  @@index([startDate, endDate])
}

/// Deux personnes à ne pas faire travailler ensemble dans un équipage (entente). driverAId < driverBId.
model CrewIncompatibility {
  id        String   @id @default(cuid())
  driverAId String
  driverBId String
  note      String?
  createdAt DateTime @default(now())

  driverA Driver @relation("IncompatibilityA", fields: [driverAId], references: [id], onDelete: Cascade)
  driverB Driver @relation("IncompatibilityB", fields: [driverBId], references: [id], onDelete: Cascade)

  @@unique([driverAId, driverBId])
}

/// Équipage d'un véhicule pour une date, fixé par le régulateur ; sans ligne, l'équipage est proposé
/// automatiquement (lib/staff/day-crews.ts). driverId null : le véhicule ne roule pas ce jour-là.
model DayCrew {
  id          String   @id @default(cuid())
  serviceDate DateTime @db.Date
  vehicleId   String
  driverId    String?
  crewMateId  String?
  /// Contrôle de concurrence : un enregistrement fait sur une version plus ancienne de la ligne est refusé.
  updatedAt   DateTime @updatedAt
  /// Compte qui a fixé ou modifié la ligne en dernier (null : inconnu, ligne antérieure).
  updatedById String?

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Driver? @relation("DayCrewDriver", fields: [driverId], references: [id], onDelete: SetNull)
  crewMate  Driver? @relation("DayCrewCrewMate", fields: [crewMateId], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("DayCrewUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([serviceDate, vehicleId])
}

/// Tournée d'un véhicule pour une date, produite par l'optimiseur puis validée par le régulateur.
model Route {
  id                String      @id @default(cuid())
  serviceDate       DateTime    @db.Date
  vehicleId         String
  driverId          String?
  crewMateId        String?
  status            RouteStatus @default(PROPOSED)
  optimizationRunId String?
  startMinute       Int
  endMinute         Int
  distanceKm        Float
  emptyKm           Float
  revenue           Float
  cost              Float
  margin            Float
  breakStartMinute  Int?
  breakEndMinute    Int?
  /// Source des temps et distances des horaires enregistrés (osrm, haversine) : calcul ou dernier recalcul.
  matrixSource      String?
  validatedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver          Driver?          @relation("RouteDriver", fields: [driverId], references: [id], onDelete: SetNull)
  crewMate        Driver?          @relation("RouteCrewMate", fields: [crewMateId], references: [id], onDelete: SetNull)
  optimizationRun OptimizationRun? @relation(fields: [optimizationRunId], references: [id], onDelete: SetNull)
  stops           RouteStop[]
  trips           Trip[]

  @@unique([serviceDate, vehicleId])
}

model RouteStop {
  id              String    @id @default(cuid())
  routeId         String
  sequence        Int
  tripId          String
  kind            StopKind
  lat             Float
  lng             Float
  address         String
  arrivalMinute   Int
  startMinute     Int
  departureMinute Int
  loadAfter       Int
  /// Horodatage réel « pris en charge » / « déposé » : l'heure du geste sur le téléphone (heure du
  /// téléphone corrigée de son décalage avec le serveur), même pour un statut envoyé plus tard depuis
  /// la file hors ligne ; bornée par le serveur (au plus 3 h avant la réception, jamais après).
  completedAt     DateTime?
  /// Réception du statut par le serveur (égale à completedAt, à quelques secondes près, hors file).
  completedReceivedAt DateTime?
  /// Compte (chauffeur ou équipier) qui a saisi completedAt.
  completedById   String?

  route       Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  trip        Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  completedBy User? @relation("RouteStopCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([routeId, sequence])
  @@index([tripId])
}

/// Grille tarifaire d'un type de véhicule, datée. Une ligne par (type, département ou « * », certification,
/// période) ; le web choisit celle de chaque véhicule (lib/domain/tariffs.ts) : taxi par le département de
/// son ADS, VSL et ambulance par la certification de l'entreprise à la date et son siège.
model TariffGrid {
  id                  String             @id @default(cuid())
  vehicleType         VehicleType
  /// Taxi : département de l'ADS ; VSL non certifié : département du siège ; « * » : toutes zones.
  department          String
  /// Grille d'une entreprise certifiée (true), non certifiée (false) ou sans objet (null : taxi).
  certified           Boolean?
  /// Zone VSL (A, B, C, D), pour l'affichage.
  zone                String?
  label               String?
  /// Forfait départemental (taxi : prise en charge et accompagnement).
  baseFare            Float
  /// Ambulance : forfait agglomération, à la place du forfait départemental.
  aggloFare           Float?
  /// Taxi : forfait « Grande ville » ajouté au forfait.
  bigCityFare         Float              @default(0)
  includedKm          Float              @default(0)
  pricePerKm          Float
  /// Trajet court : [{ "upToKm": 7, "amount": 8.54 }, …] par km croissants ; ajouté au forfait.
  shortTripBands      Json               @default("[]")
  /// Majorations (fractions) : nuit, et samedi après saturdayFromMinute, dimanche et jour férié. Jamais cumulées.
  nightRate           Float              @default(0)
  weekendRate         Float              @default(0)
  nightStartMinute    Int                @default(1200)
  nightEndMinute      Int                @default(480)
  saturdayFromMinute  Int                @default(720)
  /// Le trajet court est majoré comme le reste (question ouverte en ambulance).
  surchargeShortTrip  Boolean            @default(true)
  /// Taxi : tarif km majoré pour un retour à vide (trajet lié à une hospitalisation), selon le seuil.
  emptyLegRateShort   Float              @default(0)
  emptyLegRateLong    Float              @default(0)
  emptyLegThresholdKm Float              @default(50)
  /// Abattements de partage : [{ "patients": 2, "rate": 0.23 }, …] ; la dernière entrée vaut aussi au-delà.
  sharedDiscounts     Json               @default("[]")
  /// Patients au plus dans un transport partagé (8 taxi, 3 VSL, 1 ambulance) : plafonne la capacité envoyée.
  maxSharedPatients   Int                @default(8)
  /// Taxi : abattement d'un patient seul à bord sur au moins aloneThresholdKm d'un trajet partagé.
  aloneDiscount       Float              @default(0)
  aloneThresholdKm    Float              @default(30)
  /// Détour facturable à un patient partagé, par co-passager (VSL : 10 puis 10 km) ; vide : distance directe.
  billableDetourKm    Float[]            @default([])
  /// Supplément TPMR (patient transporté dans son fauteuil), hors majorations et abattements.
  tpmrFare            Float              @default(0)
  verification        TariffVerification @default(UNVERIFIED)
  sourceUrl           String?
  validFrom           DateTime           @db.Date
  validTo             DateTime?          @db.Date
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([vehicleType, department])
}

/// Période où l'entreprise est certifiée (géolocalisation certifiée sur tous ses véhicules et facturation
/// SEFi) : ses VSL et ambulances relèvent des grilles « majorées ».
model CompanyCertification {
  id        String    @id @default(cuid())
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  note      String?
  createdAt DateTime  @default(now())
}

/// Zone tarifaire : communes au forfait « Grande ville » (taxi) ou au forfait agglomération (ambulance).
model TariffArea {
  id           String             @id @default(cuid())
  kind         TariffAreaKind
  name         String
  department   String
  /// Noms des communes (« Marseille », « Plan-de-Cuques »…), comparés aux adresses des courses.
  communes     String[]
  rule         TariffAreaRule
  /// TO_HUB : la commune centre.
  hubCommune   String?
  validFrom    DateTime?          @db.Date
  validTo      DateTime?          @db.Date
  verification TariffVerification @default(UNVERIFIED)
  sourceUrl    String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// Jour férié retenu pour la majoration « dimanche et jour férié » (la liste n'est fixée par aucune convention).
model PublicHoliday {
  date  DateTime @id @db.Date
  label String
}

/// Paramètres globaux de l'optimiseur (ligne unique, id = 1).
model AppSettings {
  id                         Int      @id @default(1)
  waitBeforeAppointmentMin   Int      @default(30)
  waitAfterSessionMin        Int      @default(15)
  maxTotalWaitMin            Int      @default(45)
  maxDetourKmPerExtraPatient Float    @default(10)
  maxDetourKmTotal           Float    @default(30)
  /// Temps d'arrêt d'une course en taxi ou VSL (une course assise peut partir dans l'un ou l'autre).
  pickupServiceMin           Int      @default(5)
  dropoffServiceMin          Int      @default(5)
  /// Temps d'arrêt d'une course en ambulance ; null : comme le taxi et le VSL.
  ambulancePickupServiceMin  Int?
  ambulanceDropoffServiceMin Int?
  /// Minutes ajoutées à chaque arrêt d'un patient en fauteuil roulant, ou allongé.
  wheelchairExtraServiceMin  Int      @default(0)
  lyingExtraServiceMin       Int      @default(0)
  /// Temps à bord au plus égal au trajet direct + N min (de la fin de la prise en charge au début de la dépose).
  maxRideExtraMin            Int      @default(30)
  unassignedPenalty          Float    @default(10000)
  solverTimeLimitSec         Int      @default(10)
  /// Numéro de la régulation, proposé en appel direct sur la feuille de route des chauffeurs.
  regulatorPhone             String?
  /// Temps de trajet ralentis par le trafic (zones et facteurs : TrafficZone).
  trafficEnabled             Boolean  @default(true)
  morningPeakStartMinute     Int      @default(420)
  morningPeakEndMinute       Int      @default(570)
  eveningPeakStartMinute     Int      @default(960)
  eveningPeakEndMinute       Int      @default(1140)
  /// Dernière modification du réglage du trafic : seuls les plannings calculés depuis servent à calibrer les facteurs.
  trafficChangedAt           DateTime?
  /// Courses servies en moins qu'un nouveau calcul peut avoir sans demander de confirmation avant de remplacer le planning.
  replanMaxServedLoss        Int      @default(0)
  /// Baisse de marge acceptée sans confirmation, en fraction du CA du planning en place (0.1 = 10 %).
  replanMaxMarginLoss        Float    @default(0.1)
  /// Une annulation saisie moins de N heures avant la prise en charge prévue est tardive.
  lateCancellationHours      Int      @default(2)
  /// Les courses des récurrences sont créées de demain à J+N (création, modification ou réactivation
  /// d'une récurrence, d'une prescription ou d'un patient ; ouverture du planning ou des courses).
  tripHorizonDays            Int      @default(14)
  /// Équipages proposés : un remplaçant d'un autre dépôt vient d'au plus N km (à vol d'oiseau entre dépôts).
  crewMaxReplacementKm       Float    @default(60)
  /// Horaires communs minimum (min) du chauffeur et de l'équipier d'une ambulance.
  crewMinPairOverlapMin      Int      @default(240)
  /// Personnes de chaque dépôt laissées sans véhicule (réserve du jour) avant d'équiper un véhicule de réserve.
  crewReservePerDepot        Int      @default(0)
  /// Siège de l'entreprise : département (grille VSL non certifiée) et commune (forfait agglomération des ambulances).
  hqDepartment               String?
  hqCity                     String?
  /// Lecture des conventions tant que le PO ne l'a pas tranchée (Grilles tarifaires, « Règles de facturation »).
  emptyLegRule               EmptyLegRule       @default(DEPOT)
  surchargeOrder             SurchargeOrder     @default(MULTIPLICATIVE)
  sharedPatientCount         SharedPatientCount @default(DISTINCT)
  updatedAt                  DateTime @updatedAt
}

/// Ralentissement dû au trafic, par zone et par créneau : dans la zone, temps de trajet = temps fluide × facteur.
model TrafficZone {
  id            String   @id @default(cuid())
  name          String   @unique
  /// Ordre d'affichage.
  position      Int
  /// Centre et rayon du cercle ; null pour la ligne « hors agglomération » (le reste du réseau).
  lat           Float?
  lng           Float?
  radiusKm      Float?
  morningFactor Float
  dayFactor     Float
  eveningFactor Float
  updatedAt     DateTime @updatedAt
}

model OptimizationRun {
  id              String                @id @default(cuid())
  serviceDate     DateTime              @db.Date
  status          OptimizationRunStatus @default(RUNNING)
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  requestedById   String?
  tripsCount      Int                   @default(0)
  lockedCount     Int                   @default(0)
  unassignedCount Int                   @default(0)
  objective       Float?
  wallTimeMs      Int?
  matrixSource    String?
  valid           Boolean?
  /// Indicateurs renvoyés par l'optimiseur (PlanResponse.kpis).
  kpis            Json?
  /// Détails du calcul : statut du solveur, violations, avertissements, motif de chaque course non affectée.
  details         Json?
  error           String?

  requestedBy User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  routes      Route[]

  @@index([serviceDate])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole
  driverId       String?  @unique
  active         Boolean  @default(true)
  /// Incrémenté pour fermer toutes les sessions ouvertes du compte (déconnexion,
  /// désactivation, nouveau mot de passe ou nouvelle adresse e-mail) : un jeton d'une
  /// version antérieure est refusé.
  sessionVersion Int      @default(0)
  /// Mot de passe provisoire (choisi par un régulateur à la création ou à la réinitialisation du
  /// compte) : le chauffeur doit le remplacer par le sien avant d'accéder à sa feuille de route.
  mustChangePassword Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver           Driver?           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  optimizationRuns OptimizationRun[]
  completedStops   RouteStop[]       @relation("RouteStopCompletedBy")
  sharingResponses Trip[]            @relation("TripSharingRespondedBy")
  cancelledTrips   Trip[]            @relation("TripCancelledBy")
  exceptionalAmbulanceTrips Trip[]   @relation("TripExceptionalAmbulanceBy")
  dayCrews         DayCrew[]         @relation("DayCrewUpdatedBy")
  auditEvents      AuditEvent[]
}

/// Journal des accès et modifications des données de santé (traçabilité HDS / RGPD art. 32).
/// Ajout seulement : un déclencheur de la base refuse toute modification ou suppression (migration
/// audit_trail_append_only), que seuls le seed et la simulation d'historique de développement lèvent
/// le temps de leur transaction. Aucun nom de patient, adresse ni note : qui, quoi, sur quel
/// enregistrement, quand et d'où.
model AuditEvent {
  id            String    @id @default(cuid())
  at            DateTime  @default(now())
  /// Compte auteur ; null pour un échec de connexion. Un compte qui a des événements ne peut pas
  /// être supprimé (on le désactive).
  userId        String?
  /// Nom de l'auteur figé à l'écriture (rempli par la base depuis le compte s'il manque).
  actorLabel    String?
  /// Rôle de l'auteur ; null pour un échec de connexion (aucun compte authentifié).
  role          UserRole?
  /// Action en notation pointée, ex. « patient.update », « stop.pickup », « roadmap.view ».
  action        String
  /// Modèle concerné (« Patient », « Trip », « Route »…), jamais un arrêt (supprimé à chaque réoptimisation).
  entity        String
  entityId      String?
  /// Date de service concernée, quand l'action porte sur une journée planifiée.
  serviceDate   DateTime? @db.Date
  /// Adresse IP du client, seulement derrière un proxy déclaré (TRUSTED_PROXY_HOPS).
  ip            String?
  /// Empreinte du User-Agent (sha256 tronqué), jamais le texte.
  userAgentHash String?
  /// Contexte non médical de l'action : ancienne et nouvelle valeur d'un paramètre, empreinte de
  /// l'e-mail d'un échec de connexion… Jamais de nom de patient, d'adresse ni de note.
  details       Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([userId, at])
  @@index([at])
}
